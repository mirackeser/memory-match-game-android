<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="180"
                android:startColor="#FFF0F5"
                android:centerColor="#FCE4EC"
                android:endColor="#F8BBD9"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:top="-150dp"
        android:right="-80dp">
        <shape android:shape="oval">
            <solid android:color="#30FF6B95" />
            <size
                android:width="350dp"
                android:height="350dp" />
        </shape>
    </item>
    <item
        android:bottom="-100dp"
        android:left="-60dp">
        <shape android:shape="oval">
            <solid android:color="#25B388FF" />
            <size
                android:width="300dp"
                android:height="300dp" />
        </shape>
    </item>
</layer-list>